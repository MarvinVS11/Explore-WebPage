PORT=5001
NODE_ENV=production

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT — usar una clave larga y segura en producción
JWT_SECRET=cambia_esto_por_algo_muy_seguro_en_produccion

# Credenciales del administrador
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=cambia_esto_en_produccion

# URL del frontend admin en producción (para CORS)
# Ejemplo: https://explore-admin.vercel.app
ADMIN_FRONTEND_URL=https://tu-admin-frontend.vercel.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
