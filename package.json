{
  "name": "mern-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend":       "yarn --cwd backend dev",
    "dev:frontend":      "yarn --cwd frontend dev",
    "dev:admin-backend": "yarn --cwd admin/backend dev",
    "dev:admin-frontend":"yarn --cwd admin/frontend dev",

    "dev":         "concurrently -n \"API,WEB\" -c \"green,cyan\" \"yarn dev:backend\" \"yarn dev:frontend\"",
    "dev:admin":   "concurrently -n \"ADMIN-API,ADMIN-WEB\" -c \"yellow,magenta\" \"yarn dev:admin-backend\" \"yarn dev:admin-frontend\"",
    "dev:backends": "concurrently -n \"API,ADMIN-API\" -c \"green,yellow\" \"yarn dev:backend\" \"yarn dev:admin-backend\"",
    "dev:all":     "concurrently -n \"API,WEB,ADMIN-API,ADMIN-WEB\" -c \"green,cyan,yellow,magenta\" \"yarn dev:backend\" \"yarn dev:frontend\" \"yarn dev:admin-backend\" \"yarn dev:admin-frontend\"",

    "install:all": "yarn --cwd backend install && yarn --cwd frontend install && yarn --cwd admin/backend install && yarn --cwd admin/frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "main": "index.js",
  "repository": "https://github.com/MarvinVS11/Explore-WebPage.git",
  "author": "MarvinVS11 <marvi11@hotmail.es>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.6.2"
  }
}
