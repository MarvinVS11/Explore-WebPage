# Backend environment example
# Use this file as a template for production environment variables.

# Server
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (production)
# Replace <user>,<pass>,<cluster> and <dbname> with your values
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Optional: allow destructive seeding in production only when explicitly set
# FORCE_SEED=true
